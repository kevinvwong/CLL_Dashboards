APP_PASSCODE=
APP_SECRET=
# Database written by db/build_db.py. The intended working directory is ospec/
# (per ospec/README.md), so from there it is ./cll_initiatives.db.
# Inside the container the Dockerfile copies ospec/ under /app, so it is
# ./ospec/cll_initiatives.db. Set whichever matches where the app is started.
DB_PATH=./cll_initiatives.db
BACKUP_DIR=./backups
PORT=8000
