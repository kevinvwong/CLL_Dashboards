.env
__pycache__/
*.pyc
backup/
backups/
node_modules/
# SQLite sidecar files: runtime artefacts, and a stray -wal hides
# uncommitted transactions from anyone who opens the database read-only.
*.db-shm
*.db-wal

# Institutional source packages, not project artefacts. These are the only copy
# of documents authored outside this repository and may contain internal
# planning data; they are read in place and never committed. See design.md D8.
CLL_Strategy_Portfolio_Enterprise_Package_*.zip

# Build artefacts. The deploy archive is produced by
# scripts/build_deploy_zip.py and is not a source file; committing it would
# put a stale copy of the database and the app in the tree. See docs/ops/DEPLOY.md.
deploy.zip

# The cwd-relative default database is a runtime artefact. Config.DB_PATH defaults
# to "./cll_initiatives.db", so anything that connects without an explicit path
# while the working directory is a subfolder leaves an empty database there. The
# real sample database is cll_initiatives.db, which IS committed; this covers
# only the stray the default creates.
app/cll_initiatives.db
# The brainstorming visual companion's session files (mockups, state).
.superpowers/
