APP_PASSCODE=
APP_SECRET=
# Database written by db/build_db.py. The intended working directory is the
# repo root, so it is ./cll_initiatives.db. Inside the container the Dockerfile
# copies the app to /app, where it is also ./cll_initiatives.db.
DB_PATH=./cll_initiatives.db
BACKUP_DIR=./backups
PORT=8000

# --- authentication provider (ADR-0004) --------------------------------------
# local = the built-in stopgap (shared passcode + person picker, closed per
#         person by a PIN). This is the default and needs APP_PASSCODE/APP_SECRET.
# clerk = verify a Clerk session token instead; set the three CLERK_* values.
AUTH_PROVIDER=local

# Clerk (only when AUTH_PROVIDER=clerk). CLERK_SECRET_KEY is server-side only and
# must never reach the browser. The publishable key is public by design.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# The origin(s) allowed to mint a session, comma-separated.
# CLERK_AUTHORIZED_PARTY=http://localhost:8000,http://127.0.0.1:8000
# Optional override; the frontend API is normally derived from the publishable key.
# CLERK_FRONTEND_API=
